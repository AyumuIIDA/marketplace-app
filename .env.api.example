# api(Hono) 専用 env テンプレート。→ .env.api を生成。
# 重要: ここには BFF内部JWTの【公開鍵のみ】を置く。秘密鍵は絶対に置かない。
#   APIは公開鍵で検証のみを行い、内部トークンを署名(偽造)できない、という非対称性を保つ。
#   node docker/gen-secrets.mjs が公開鍵を自動充填する。
# DATABASE_URL は compose 側で per-service に設定する（ここには書かない）。

# --- BFF内部JWT (EdDSA, 公開鍵のみ) --- gen-secrets.mjs が自動生成
BFF_INTERNAL_JWT_PUBLIC_KEY=
# 本番誤設定防止。Auth.js経由ログインを使うため false。
BFF_ALLOW_DEV_USER_HEADER=false

# --- Human Signature / World ID (ローカルはダミー可) ---
HUMAN_SIGNATURE_ISSUER=local-marketplace
# gen-secrets.mjs が自動生成
HUMAN_SIGNATURE_JWS_SECRET=
WORLD_ID_RP_ID=local

# --- AI assistant ---
# 既定はキー不要の決定論fake（デモ安定優先）。OpenAIを使う場合は openai に変更し下2つを設定。
# 切替後は `npm run ai:smoke` で実接続を検証してから本番投入すること。
AI_ASSISTANT_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=
