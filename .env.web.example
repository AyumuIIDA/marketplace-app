# web(Next.js: front + BFF) 専用 env テンプレート。→ .env.web を生成。
# 重要: ここには BFF内部JWTの【秘密鍵のみ】を置く。公開鍵側(api)とは別ファイル。
#   秘密鍵はBFFのみが保持し署名する。APIへは渡さない（非対称性の核）。
#   node docker/gen-secrets.mjs が秘密鍵を自動充填する。
# DATABASE_URL / HONO_API_BASE_URL / AUTH_URL 等は compose 側で per-service に設定する。

# --- Auth.js ---
# gen-secrets.mjs が自動生成
AUTH_SECRET=
# OAuth。各providerでアプリ登録し、callbackを設定する:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Resend(マジックリンク)は未使用でも、auth.tsのprovider構築にEMAIL_FROMが必須。
EMAIL_FROM=login@localhost
# 実際にマジックリンクを使う場合のみ:
AUTH_RESEND_KEY=

# --- BFF内部JWT (EdDSA, 秘密鍵のみ) --- gen-secrets.mjs が自動生成
BFF_INTERNAL_JWT_PRIVATE_KEY=

# --- World ID / World App ---
# Developer Portal で発行。API側(.env.api)の WORLD_ID_RP_ID と同じRP IDを設定する。
WORLD_ID_RP_ID=
# Developer Portal で発行するRP signing key(hex)。BFFだけが保持し、IDKit request contextを署名する。
WORLD_ID_RP_SIGNING_KEY_HEX=
NEXT_PUBLIC_WORLD_ID_APP_ID=
# production または staging
NEXT_PUBLIC_WORLD_ID_ENVIRONMENT=staging
# World App MiniKit Pay の受取アドレス。World ID連携済みユーザー向けWorldcoin決済に使う。
NEXT_PUBLIC_WORLDCOIN_RECEIVER_ADDRESS=
# JPY建て表示価格をWLDに換算するための運用設定。例: 1 WLD = 300 JPY なら 300。
NEXT_PUBLIC_WLD_JPY_RATE=
# MiniKit Pay 結果をWorld Developer APIで検証するためのDeveloper Portal API key。
WORLD_DEVELOPER_PORTAL_API_KEY=
# E2E/ローカル検証でのみ使用。未設定なら公式 World Developer API を使う。
WORLDCOIN_PAYMENT_CONFIRM_BASE_URL=
