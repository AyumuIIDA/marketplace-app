# web(Next.js: front + BFF) 専用 env テンプレート。→ .env.web を生成。
# 重要: ここには BFF内部JWTの【秘密鍵のみ】を置く。公開鍵側(api)とは別ファイル。
#   秘密鍵はBFFのみが保持し署名する。APIへは渡さない（非対称性の核）。
#   node docker/gen-secrets.mjs が秘密鍵を自動充填する。
# DATABASE_URL / HONO_API_BASE_URL / AUTH_URL 等は compose 側で per-service に設定する。

# --- Auth.js ---
# gen-secrets.mjs が自動生成
AUTH_SECRET=
# OAuth。各providerでアプリ登録し、callbackを設定する:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Resend(マジックリンク)は未使用でも、auth.tsのprovider構築にEMAIL_FROMが必須。
EMAIL_FROM=login@localhost
# 実際にマジックリンクを使う場合のみ:
AUTH_RESEND_KEY=

# --- BFF内部JWT (EdDSA, 秘密鍵のみ) --- gen-secrets.mjs が自動生成
BFF_INTERNAL_JWT_PRIVATE_KEY=
