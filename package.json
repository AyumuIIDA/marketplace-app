{
  "type": "module",
  "bin": {
    "weather": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "api:build": "tsc -p api/tsconfig.json",
    "api:dev": "tsx api/src/server.ts",
    "api:start": "node api/build/server.js",
    "api:test": "vitest run --config api/vitest.config.ts",
    "ai:smoke": "tsx api/src/scripts/openai-smoke.ts",
    "web:build": "npm run build --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:start": "npm run start --prefix web",
    "db:generate": "drizzle-kit generate --config=api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=api/drizzle.config.ts",
    "db:auth:generate": "drizzle-kit generate --config=web/drizzle.config.ts",
    "db:auth:migrate": "drizzle-kit migrate --config=web/drizzle.config.ts"
  },
  "files": [
    "build"
  ],
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.8.0",
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "jose": "^6.2.3",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "sharp": "^0.35.1",
    "zod": "^4.4.3"
  }
}
