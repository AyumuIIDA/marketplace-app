# デプロイ/運用タスクの設定値。`cp .env.deploy.example .env.deploy` で生成し値を埋める。
# .env.deploy は .gitignore 済（コミットされない）。
#
# 方針:
# - ここに置く認証情報は「ローカル migration / psql の便宜」用。
# - Cloud Run runtime のシークレット（socket形式DATABASE_URLや鍵）は Secret Manager に置く（後の手順）。
# - 値に `$` や `#` を含めない（Makefile include が誤解釈する）。含む場合は Secret Manager を使う。

# --- GCP ---
GCP_PROJECT=
GCP_REGION=asia-northeast1
# Cloud SQL インスタンス接続名: PROJECT:REGION:INSTANCE
CLOUDSQL_INSTANCE=
# Cloud Run サービス名（logs-api で使用）
API_SERVICE=marketplace-api

# --- ローカル migration / psql（cloud-sql-proxy 経由, TCP 127.0.0.1） ---
# proxy が開くローカルポート
PROXY_PORT=5432
DOMAIN_DB_NAME=marketplace_domain
DOMAIN_DB_USER=postgres
# Cloud SQL の DB パスワード（ローカル接続用。gitignore済の本ファイルのみ）
DOMAIN_DB_PASSWORD=

# --- 認証DB（Neon, GCP外・proxy不要・直TLS） ---
# sslmode=require 込みのフル接続URL
AUTH_DATABASE_URL=
